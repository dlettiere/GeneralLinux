# DanAliases - General Linux Aliases (Refactored)
# https://github.com/dlettiere/GeneralLinux

# --- Navigation & Directory Listing ---
alias ls='ls -alh --color=auto'
alias la='ls -Ah --color=auto'
alias l='ls -CFh --color=auto'
alias dush='du -sh'

# --- Shell Management ---
alias edital='${EDITOR:-nano} ~/.bash_aliases'
alias ba='edital'
alias r='source ~/.bashrc'

# --- Package Management ---
alias apt='sudo apt'
alias uppy='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y && sudo apt autoclean -y'
alias reboot='sudo reboot'

# --- Docker & Compose ---
alias dockup='docker compose up -d'
alias dockdown='docker compose down'
alias docklogs='docker compose logs -tf --tail=100'
alias dockedit='${EDITOR:-nano} docker-compose.yml'
alias dc='docker compose'

# --- Rsync Helpers ---
alias rcopy='rsync -a --info=progress2 --no-i-r'
alias rcopydry='rsync -a -n --info=progress2 --no-i-r'
alias rmove='sudo rsync -a --info=progress2 --no-i-r --remove-source-files'

# --- Utilities & Cleanup ---
alias ta='tmux a'
alias nfowipe='find . -type f -name "*.nfo" -delete'
alias txtwipe='find . -type f -name "*.txt" -delete'

# --- Custom Functions ---

# Kill zombie processes safely by targeting the parent PID (protects PID 1)
function killZombie() {
    local pids
    pids=$(ps -A -ostat,ppid | awk '/[zZ]/ && !a[$2]++ {print $2}')
    
    if [ -z "$pids" ]; then
        echo "No zombie processes found."
        return 0
    fi

    for pid in $pids; do
        if [ "$pid" -eq 1 ]; then
            echo "Zombie parent is PID 1 (init/systemd). Cannot kill PID 1."
            continue
        fi
        
        local cmd
        cmd=$(ps -p "$pid" -o cmd= 2>/dev/null || echo "Unknown")
        echo "Found zombie parent PID: $pid ($cmd)"
        read -r -p "Kill parent process $pid? [y/N] " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            sudo kill -9 "$pid"
            echo "Killed PID $pid"
        fi
    done
}

# Create a tar.gz archive cleanly handling trailing slashes
function mktar() {
    if [ -z "${1:-}" ]; then
        echo "Usage: mktar <directory_or_file>"
        return 1
    fi
    local target="${1%/}"
    tar -czvf "${target}.tar.gz" "$target"
}

# Interactive cheat sheet lookup (supports multi-word queries: cheat tar extract)
function cheat() {
    if [ -z "${1:-}" ]; then
        echo "Usage: cheat <command_or_topic>"
        return 1
    fi
    local query
    query=$(echo "$*" | tr ' ' '+')
    curl -s "https://cheat.sh/${query}"
}

# Directory summary stats (all files & total size)
function stats() {
    local count size
    count=$(find . -type f 2>/dev/null | wc -l)
    size=$(du -sh . 2>/dev/null | awk '{print $1}')
    echo "Directory: $(pwd)"
    echo "Total Files: $count"
    echo "Total Size:  $size"
}

# --- Load Local Overrides (at bottom so local rules can override defaults) ---
if [ -f "$HOME/.bash_aliases_local" ]; then
    . "$HOME/.bash_aliases_local"
fi
